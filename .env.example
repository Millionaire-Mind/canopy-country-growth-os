# Copy to .env and fill in for local development. Never commit .env.
# In Vercel, these are set directly in the project's Environment Variables settings,
# not read from this file — see docs/DEPLOYMENT.md.

# Postgres connection strings (Neon, or any Postgres). DATABASE_URL should be the
# pooled connection string used for normal app queries; DIRECT_URL should be the
# unpooled/direct connection string, used only for `prisma db push`/migrate.
# For local development against a single local Postgres, both can point to the same
# database.
DATABASE_URL="postgresql://user:password@localhost:5432/canopy_dev"
DIRECT_URL="postgresql://user:password@localhost:5432/canopy_dev"

# Auth.js session-signing secret. Generate with: npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET="change-me"

# --- Future integrations (not wired up in V1; see docs/INTEGRATIONS.md) ---
# GA4_PROPERTY_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=
