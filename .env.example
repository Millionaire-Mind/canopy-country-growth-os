# Copy to .env and fill in. Never commit .env.

# SQLite for local/weekend development. Point this at a Postgres URL in production
# (Prisma datasource supports both without a schema rewrite).
DATABASE_URL="file:./dev.db"

# Shared password for the V1 single-password auth gate. Change before any real use.
APP_PASSWORD="change-me"

# Random long string used to sign the session cookie.
SESSION_SECRET="change-me-too"

# --- Future integrations (not wired up in V1; see docs/INTEGRATIONS.md) ---
# GA4_PROPERTY_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=
